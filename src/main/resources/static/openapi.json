      "get": {
        "summary": "Read current catalog and connections with an edit revision",
        "responses": {
          "200": {
            "description": "Complete runtime configuration; credential references only"
          }
        }
      },
      "put": {
        "summary": "Validate, persist and apply a complete configuration revision without restart",
        "description": "Local administrator operation. Requires session CSRF header and matching revision. Catalog and connection maps are supplied together. Active runs keep saved plans; connection edits invalidate portal tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "revision",
                  "catalog",
                  "connections"
                ],
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": "string"
                  },
                  "catalog": {
                    "type": "object"
                  },
                  "connections": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved document with new revision"
          },
          "409": {
            "description": "Stale edit; reload required"
          },
          "422": {
            "description": "Invalid configuration; previous version retained"
          },
          "503": {
            "description": "Persistence failed; previous version retained"
          }
        }
      }
    }
