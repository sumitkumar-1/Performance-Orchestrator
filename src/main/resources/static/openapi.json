  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "targetEnvironment": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "serviceId": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "DEPLOY",
                    "VERIFY_EXISTING"
                  ]
                },
                "build": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRef": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "sourceRef",
                    "version"
                  ]
                },
                "valuesOverlay": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "serviceId",
                "action",
                "build"
              ]
            }
          },
          "loadGenerator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "templateRef": {
                "type": "string"
              },
              "virtualUsers": {
                "type": "integer",
                "minimum": 1
              },
              "requestsPerSecond": {
                "type": "integer",
                "minimum": 1
              },
              "warmupSeconds": {
                "type": "integer",
                "minimum": 0
              },
              "measurementSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "configurationOverlay": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "required": [
              "templateRef",
              "virtualUsers",
              "requestsPerSecond",
              "warmupSeconds",
              "measurementSeconds"
            ]
          },
          "maxRunDurationSeconds": {
            "type": "integer",
            "minimum": 15
          },
          "thresholds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metric": {
                  "type": "string",
                  "enum": [
                    "latency_p95_ms",
                    "error_rate",
                    "throughput_rps",
                    "request_count"
                  ]
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "metric",
                "maximum",
                "required"
              ]
            }
          },
          "simulationCase": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "DEPLOYMENT_FAILURE",
              "READINESS_TIMEOUT",
              "MISSING_METRICS",
              "THRESHOLD_FAILURE",
              "CLEANUP_FAILURE"
            ]
          }
        },
        "required": [
          "name",
          "targetEnvironment",
          "services",
          "loadGenerator",
          "maxRunDurationSeconds",
          "thresholds",
          "simulationCase"
        ]
      },
      "ProfileInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "profile"
        ]
      },
      "PlanInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profileId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": []
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "planId": {
            "type": "string"
          },
          "profileId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": []
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "message"
        ]
      }
    }
  }
}
